import math

A= 0.13587 * 25.4**2
w= 0.008 *25.4
max_height = 3/8 * 25.4
r=0.6925 *25.4/2
arc=2*r*math.asin (w/(2*r))

def calculateorifices (A):
   N = math.ceil(A/(2*arc*(max_height-4)))
   top_height= A/(2*N*arc)+4
   bottom_height= A/(2*N*arc)+2.5
   print("Top row:", N, "orifices") 
   print("Bottom row:", N, "orifices") 
   print("Top height:", top_height, "mm") 
   print("Bottom height:", bottom_height, "mm") 

calculateorifices (A)


