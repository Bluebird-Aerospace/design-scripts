bottom 2.5mm of height blocked

top row higher than bottom """

import matplotlib.pyplot as plt
import numpy as np
N_values = list(range(10, 71))
heights = []

for N in N_values:
    top_height= A/(2*N*arc)+4
    bottom_height= A/(2*N*arc)+2.5
    heights.append(max(top_height, bottom_height))

plt.plot(N_values, heights, label="Maximum orifice height")
plt.axhline(max_height, color="red", linestyle="--", label="Height limit (3/8 in)")

plt.xlabel("Number of Orifices per Row")
plt.ylabel("Maximum Height (mm)")
plt.title("Maximum Orifice Height vs. Number of Orifices")
plt.legend()
plt.grid()
plt.show()